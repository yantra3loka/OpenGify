# Copy to .env for local development.
# Must match the frozen contract's servers[0].url (openapi.yaml).
VITE_API_URL=http://localhost:8000

# Mock mode: build the UI against contract-shaped in-memory data while
# Keval's backend isn't live yet. Flip to false (or delete the line) once
# the real API is up — no code changes needed.
VITE_USE_MOCKS=true
